generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  ADMIN
  COMPANY_ROOT
  HR
  CANDIDATE
}

enum AppStatus {
  SCREENING
  TESTING
  REVIEWING
  COMPLETED
  REJECTED
}

enum EventType {
  PASTE_EVENT
  TAB_SWITCH
  RAPID_TYPING
}

enum TemplateType {
  BASIC_JS
  NEXTJS
  REACT_VITE
  BLANK_CUSTOM
}

model Company {
  id                  String   @id @default(uuid())
  name                String   @unique
  apiKey              String?  @db.Text
  tokenUsage          Int      @default(0)
  aiSuggestionEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users         User[]
  jobs          JobDescription[]
  emailAccounts EmailAccount[]
  templates     Template[]
}

model User {
  id             String  @id @default(uuid())
  email          String  @unique
  githubId       String? @unique
  githubUsername String?
  name           String?
  avatarUrl      String?
  role           Role    @default(CANDIDATE)
  companyId      String?

  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sessions         Session[]
  applications     Application[]
  createdJobs      JobDescription[] @relation("JobCreator")
  createdTemplates Template[]       @relation("TemplateCreator")
  emailAccounts    EmailAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailAccount {
  id                String    @id @default(uuid())
  email             String    @unique
  encryptedPassword String    @db.Text
  userId            String
  companyId         String
  isActive          Boolean   @default(true)
  lastUsed          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs    JobDescription[]
}

model Template {
  id           String       @id @default(uuid())
  name         String
  description  String?
  templateType TemplateType
  initialCode  Json
  isPublic     Boolean      @default(false)
  createdBy    String?
  companyId    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  creator   User?          @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  company   Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scenarios TestScenario[]
}

model JobDescription {
  id                String                       @id @default(uuid())
  title             String
  content           String
  embedding         Unsupported("vector(3072)")?
  jobReference      String?
  isActive          Boolean                      @default(true)
  creatorId         String?
  companyId         String
  emailAccountId    String?
  defaultScenarioId String?                      @unique
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  creator         User?          @relation("JobCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emailAccount    EmailAccount?  @relation(fields: [emailAccountId], references: [id])
  defaultScenario TestScenario?  @relation("DefaultScenario", fields: [defaultScenarioId], references: [id])
  applications    Application[]
  scenarios       TestScenario[] @relation("JobScenarios")
}

model TestScenario {
  id          String   @id @default(uuid())
  jobId       String
  title       String
  difficulty  String
  timeLimit   Int      @default(90)
  context     String   @db.Text
  initialCode Json
  templateId  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job           JobDescription  @relation("JobScenarios", fields: [jobId], references: [id], onDelete: Cascade)
  template      Template?       @relation(fields: [templateId], references: [id])
  defaultForJob JobDescription? @relation("DefaultScenario")
  testSessions  TestSession[]
}

model Application {
  id          String                       @id @default(uuid())
  userId      String
  jobId       String
  cvText      String
  cvEmbedding Unsupported("vector(3072)")?
  matchScore  Float?
  status      AppStatus                    @default(SCREENING)

  user        User              @relation(fields: [userId], references: [id])
  job         JobDescription    @relation(fields: [jobId], references: [id])
  testSessions TestSession[]
  report      AssessmentReport?
}

model TestSession {
  id            String    @id @default(uuid())
  applicationId String
  scenarioId    String
  startTime     DateTime?
  endTime       DateTime?
  finalCode     Json?

  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scenario      TestScenario   @relation(fields: [scenarioId], references: [id])
  ideEvents     IdeEvent[]
  conversations Conversation[]
}

model IdeEvent {
  id        String    @id @default(uuid())
  sessionId String
  eventType EventType
  payload   Json
  createdAt DateTime  @default(now())

  session TestSession @relation(fields: [sessionId], references: [id])
}

model AssessmentReport {
  id                 String  @id @default(uuid())
  applicationId      String  @unique
  architectureScore  Float?
  cleanCodeScore     Float?
  riskFlags          Json?
  interviewQuestions Json?
  summary            String?

  application Application @relation(fields: [applicationId], references: [id])
}

model Conversation {
  id        String   @id @default(uuid())
  testId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session  TestSession @relation(fields: [testId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String   @db.Text
  status         String   @default("completed")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
